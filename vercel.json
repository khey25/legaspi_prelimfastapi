{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/gta/businesses/(.*)", "destination": "/api/index.py" },
    { "source": "/gta/contact/(.*)", "destination": "/api/index.py" },
    { "source": "/gta/heists/(.*)", "destination": "/api/index.py" }
  ]
}
